# Copy these into Replit Secrets. Never commit real values.
CLUB_NAME=Country Club Tennis League
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me
BASE_URL=https://courtcall.your-account.repl.co

# While DRY_RUN=true no email is sent; everything shows up under Log.
DRY_RUN=true
SENDGRID_API_KEY=
FROM_EMAIL=noreply@yourclub.com

SMS_ENABLED=false
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

TIMEZONE=America/Chicago
SCHEDULER_ENABLED=true

CONFIRM_HOURS_BEFORE=48
REMINDER_HOURS=12
EXPIRE_HOURS=24
WAVE1_HOURS=8
WAVE1_EXTRA=2
LINEUP_HOURS_BEFORE=14
CUTOFF_HOURS=3
